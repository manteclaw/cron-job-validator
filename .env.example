# Copy to .env or export in your shell / cron environment. All optional.
# Defaults are shown; uncomment and edit what you need.

# validate-cron.py: base directory that relative scripts/... paths in
# the crontab are resolved against
# CRON_WORKSPACE=/path/to/your/workspace

# validate-cron.py: crontab file to parse
# (default: <workspace>/crontab.txt)
# CRON_TAB_FILE=/path/to/your/crontab.txt

# with-lock.sh: base directory the wrapped script path is resolved
# against, and where .env is read from (default: current directory)
# WITH_LOCK_BASE=/path/to/your/workspace

# with-lock.sh: lock directory (default: $WITH_LOCK_BASE/.state/locks)
# WITH_LOCK_DIR=/path/to/your/locks

# with-lock.sh sources $WITH_LOCK_BASE/.env generically (set -a; . .env;
# set +a): put whatever variables your cron scripts need there, e.g.
# SOME_API_KEY=...
